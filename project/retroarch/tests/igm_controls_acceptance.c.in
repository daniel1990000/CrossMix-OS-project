/* SPDX-License-Identifier: GPL-3.0-or-later
 * Actual patched IGM handlers/input functions. RJSON event delivery, rendering,
 * command dispatch and physical joypad polling are narrow host fixtures. */
#include <assert.h>
#include <ctype.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "spruce_igm_theme.h"
#define ARRAY_SIZE(value) (sizeof(value) / sizeof((value)[0]))
#define IGM_FONT_PRIMARY "/fixture/font.ttf"
#define RARCH_WARN(...)
#define RETRO_DEVICE_ID_JOYPAD_B 0
#define RETRO_DEVICE_ID_JOYPAD_UP 4
#define RETRO_DEVICE_ID_JOYPAD_DOWN 5
#define RETRO_DEVICE_ID_JOYPAD_LEFT 6
#define RETRO_DEVICE_ID_JOYPAD_RIGHT 7
#define RETRO_DEVICE_ID_JOYPAD_A 8
#define RETRO_DEVICE_ID_JOYPAD_R3 15
#define CMD_EVENT_SAVE_STATE 1
#define CMD_EVENT_SAVE_STATE_DECREMENT 2
#define CMD_EVENT_SAVE_STATE_INCREMENT 3
#define IGM_NO_PENDING -1
#define IGM_PREVIEW_NO_SLOT -999
#define IGM_PRESSED(cur, prev, btn) (((cur) & (1 << (btn))) && !((prev) & (1 << (btn))))
#define strlcpy fixture_strlcpy

static size_t strlcpy(char *out, const char *in, size_t size) {
   size_t len = strlen(in);
   if (size) { size_t count = len < size - 1 ? len : size - 1; memcpy(out, in, count); out[count] = '\0'; }
   return len;
}
static bool string_is_equal(const char *a, const char *b) { return strcmp(a, b) == 0; }
static void fill_pathname_resolve_relative(char *out, const char *path, const char *in, size_t size) {
   (void)path; strlcpy(out, in, size);
}
/*@@SECTION@@*/
/*@@CONTEXT@@*/
/*@@COLOR@@*/
/*@@DEFAULTS@@*/
/*@@COLOR_KEYS@@*/
/*@@LABEL_KEYS@@*/
/*@@MEMBER@@*/
/*@@OBJECT_START@@*/
/*@@OBJECT_END@@*/
/*@@STRING@@*/
/*@@BOOL@@*/
/*@@ITEMS@@*/

static uint16_t raw_buttons;
static int commands[4];
static int16_t input_driver_state_raw_joypad(unsigned port, unsigned id) {
   assert(port == 0); return (raw_buttons >> id) & 1;
}
static void command_event(int event, void *unused) { (void)unused; commands[event]++; }
static struct {
   int selected, pending_action, deferred_close, preview_slot;
   uint16_t prev_buttons;
   const spruce_igm_theme_t *theme;
} igm;
/*@@READ_BUTTONS@@*/
/*@@RESOLVE@@*/
/*@@HANDLE_INPUT@@*/

static void member(igm_parse_ctx *ctx, const char *name) { assert(igm_on_member(ctx, name, strlen(name))); }
static void string_value(igm_parse_ctx *ctx, const char *name, const char *value) {
   member(ctx, name); assert(igm_on_string(ctx, value, strlen(value)));
}
static void configure(spruce_igm_theme_t *theme, bool enabled, const char *confirm, const char *back) {
   igm_parse_ctx ctx = {0}; ctx.t = theme; ctx.path = "/fixture/igm.json"; ctx.depth = 1;
   member(&ctx, "project_menu_controls"); assert(igm_on_object_start(&ctx));
   member(&ctx, "enabled"); assert(igm_on_bool(&ctx, enabled));
   string_value(&ctx, "confirm", confirm); string_value(&ctx, "back", back);
   assert(igm_on_object_end(&ctx));
}
static void reset(const spruce_igm_theme_t *theme) {
   memset(&igm, 0, sizeof(igm)); memset(commands, 0, sizeof(commands)); raw_buttons = 0;
   igm.theme = theme; igm.deferred_close = igm.pending_action = IGM_NO_PENDING; igm.preview_slot = 42;
}
static void press(unsigned key) { raw_buttons = 1u << key; igm_handle_input(); }
static void release(void) { raw_buttons = 0; igm_handle_input(); }

int main(int argc, char **argv) {
   assert(argc == 2);
   spruce_igm_theme_t theme;
   igm_theme_set_defaults(&theme);
   const char *scenario = argv[1];
   unsigned confirm, back;
   if (strcmp(scenario, "defaults") == 0) {
      igm_project_menu_keys(&theme, &confirm, &back);
      assert(confirm == RETRO_DEVICE_ID_JOYPAD_A && back == RETRO_DEVICE_ID_JOYPAD_B);
      configure(&theme, false, "south", "east");
      igm_project_menu_keys(&theme, &confirm, &back);
      assert(confirm == RETRO_DEVICE_ID_JOYPAD_A && back == RETRO_DEVICE_ID_JOYPAD_B);
   } else if (strcmp(scenario, "south") == 0 || strcmp(scenario, "east") == 0) {
      bool south = strcmp(scenario, "south") == 0;
      configure(&theme, true, south ? "south" : "east", south ? "east" : "south");
      igm_project_menu_keys(&theme, &confirm, &back);
      assert(confirm == (south ? RETRO_DEVICE_ID_JOYPAD_B : RETRO_DEVICE_ID_JOYPAD_A));
      assert(back == (south ? RETRO_DEVICE_ID_JOYPAD_A : RETRO_DEVICE_ID_JOYPAD_B));
      reset(&theme); igm.selected = IGM_SAVE_STATE;
      press(confirm); assert(commands[CMD_EVENT_SAVE_STATE] == 1 && igm.preview_slot == IGM_PREVIEW_NO_SLOT);
      press(confirm); assert(commands[CMD_EVENT_SAVE_STATE] == 1); /* held button */
      release(); press(back); assert(igm.deferred_close == IGM_RESUME && igm.pending_action == IGM_NO_PENDING);
      press(back); assert(igm.pending_action == IGM_NO_PENDING); release(); assert(igm.pending_action == IGM_RESUME);
   } else if (strcmp(scenario, "invalid") == 0) {
      const char *pairs[][2] = {{"south", "south"}, {"south", ""}, {"", "east"}, {"south-extra", "east"}, {"SOUTH", "east"}};
      for (unsigned i = 0; i < ARRAY_SIZE(pairs); ++i) {
         configure(&theme, true, pairs[i][0], pairs[i][1]);
         igm_project_menu_keys(&theme, &confirm, &back);
         assert(confirm == RETRO_DEVICE_ID_JOYPAD_A && back == RETRO_DEVICE_ID_JOYPAD_B);
      }
   } else if (strcmp(scenario, "nested") == 0) {
      igm_parse_ctx ctx = {0}; ctx.t = &theme; ctx.path = "/fixture"; ctx.depth = 1;
      member(&ctx, "project_menu_controls"); igm_on_object_start(&ctx);
      member(&ctx, "nested"); igm_on_object_start(&ctx);
      member(&ctx, "enabled"); igm_on_bool(&ctx, true);
      string_value(&ctx, "confirm", "south"); string_value(&ctx, "back", "east");
      igm_project_menu_keys(&theme, &confirm, &back);
      assert(!theme.project_independent_menu_controls && confirm == RETRO_DEVICE_ID_JOYPAD_A);
   } else if (strcmp(scenario, "navigation") == 0) {
      configure(&theme, true, "south", "east"); reset(&theme);
      press(RETRO_DEVICE_ID_JOYPAD_UP); assert(igm.selected == IGM_ITEM_COUNT - 1); release();
      press(RETRO_DEVICE_ID_JOYPAD_DOWN); assert(igm.selected == 0); release();
      igm.selected = IGM_SAVE_STATE;
      press(RETRO_DEVICE_ID_JOYPAD_LEFT); release(); press(RETRO_DEVICE_ID_JOYPAD_RIGHT); release();
      assert(commands[CMD_EVENT_SAVE_STATE_DECREMENT] == 1 && commands[CMD_EVENT_SAVE_STATE_INCREMENT] == 1);
   } else if (strcmp(scenario, "deferred") == 0) {
      configure(&theme, true, "south", "east"); reset(&theme); igm.selected = IGM_EXIT;
      press(RETRO_DEVICE_ID_JOYPAD_B); assert(igm.deferred_close == IGM_EXIT && igm.pending_action == IGM_NO_PENDING);
      raw_buttons = (1u << RETRO_DEVICE_ID_JOYPAD_A) | (1u << RETRO_DEVICE_ID_JOYPAD_B); igm_handle_input();
      assert(igm.pending_action == IGM_NO_PENDING); release(); assert(igm.pending_action == IGM_EXIT);
   } else assert(!"unknown scenario");
   return 0;
}
