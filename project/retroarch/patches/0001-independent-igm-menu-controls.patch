+/* Independent IGM controls are separate from the RetroArch standard menu
+ * and gameplay remaps. Raw libretro B is south and A is east; installed pad
+ * correspondence still requires the device profile's physical acceptance. */
+static void igm_project_menu_keys(const spruce_igm_theme_t *theme, unsigned *confirm, unsigned *back)
+{
+   *confirm = RETRO_DEVICE_ID_JOYPAD_A;
+   *back    = RETRO_DEVICE_ID_JOYPAD_B;
+   if (!theme || !theme->project_independent_menu_controls)
+      return;
+   if (strcmp(theme->project_menu_confirm, "south") == 0 && strcmp(theme->project_menu_back, "east") == 0)
+   {
+      *confirm = RETRO_DEVICE_ID_JOYPAD_B;
+      *back    = RETRO_DEVICE_ID_JOYPAD_A;
+   }
+   /* The complete east/south pair selects the legacy keys explicitly.
+    * Every invalid/incomplete pair falls back to those same legacy keys. */
+}
