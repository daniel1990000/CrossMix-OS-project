+	// Qualification-only API: call from the emulator owner, never a signal handler.
+	// Full ROM hashing is deliberately opt-in and may pause emulation for large ISOs.
+	struct ProjectFileFingerprint {
+		std::string sha256;
+		uint64_t size = 0;
+		bool operator==(const ProjectFileFingerprint &other) const {
+			return sha256 == other.sha256 && size == other.size;
+		}
+	};
+
+	static bool ProjectFingerprintFile(const Path &path, uint64_t limit, ProjectFileFingerprint *output) {
+#if defined(SDL) && defined(__linux__)
+		if (path.Type() != PathType::NATIVE || !path.IsAbsolute() || path.size() > 4096 ||
+			path.ToString().find('\0') != std::string::npos)
+			return false;
+		int descriptor = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+		if (descriptor < 0)
+			return false;
+		FILE *file = fdopen(descriptor, "rb");
+		if (!file) {
+			close(descriptor);
+			return false;
+		}
+		struct stat before{}, after{}, named{};
+		auto sameFile = [](const struct stat &a, const struct stat &b) {
+			return a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_size == b.st_size &&
+				a.st_mtim.tv_sec == b.st_mtim.tv_sec && a.st_mtim.tv_nsec == b.st_mtim.tv_nsec &&
+				a.st_ctim.tv_sec == b.st_ctim.tv_sec && a.st_ctim.tv_nsec == b.st_ctim.tv_nsec;
+		};
+		if (fstat(fileno(file), &before) != 0 || !S_ISREG(before.st_mode) ||
+			before.st_size <= 0 || (uint64_t)before.st_size > limit) {
+			fclose(file);
+			return false;
+		}
+		sha256_context hash;
+		sha256_starts(&hash);
+		uint8_t data[65536];
+		uint64_t bytes = 0;
+		while (bytes < (uint64_t)before.st_size) {
+			size_t count = fread(data, 1, std::min<uint64_t>(sizeof(data), (uint64_t)before.st_size - bytes), file);
+			if (count == 0)
+				break;
+			sha256_update(&hash, data, (uint32_t)count);
+			bytes += count;
+		}
+		bool ok = bytes == (uint64_t)before.st_size && !ferror(file) &&
+			fstat(fileno(file), &after) == 0 && stat(path.c_str(), &named) == 0 &&
+			sameFile(before, after) && sameFile(after, named);
+		if (fclose(file) != 0)
+			ok = false;
+		if (!ok)
+			return false;
+		uint8_t digest[32];
+		sha256_finish(&hash, digest);
+		static const char hex[] = "0123456789abcdef";
+		output->sha256.clear();
+		for (uint8_t byte : digest) {
+			output->sha256 += hex[byte >> 4];
+			output->sha256 += hex[byte & 15];
+		}
+		output->size = bytes;
+		return true;
+#else
+		return false;
+#endif
+	}
+
+	static bool ProjectEvidenceID(std::string_view value, size_t max, bool dot) {
+		if (value.empty() || value.size() > max)
+			return false;
+		for (unsigned char ch : value) {
+			if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+				(ch >= '0' && ch <= '9') || ch == '_' || ch == '-' || (dot && ch == '.')))
+				return false;
+		}
+		return true;
+	}
+
+	void SaveSlotWithEvidence(int slot, std::string requestID, SlotEvidenceCallback callback) {
+		if (!callback)
+			return;
+		auto reject = [&callback](const char *reason) { callback(Status::FAILURE, reason, nullptr); };
+		if (!ProjectEvidenceID(requestID, 96, false) || slot < 0 || slot >= g_Config.iSaveStateSlotCount || slot > 99) {
+			reject("Invalid state evidence request");
+			return;
+		}
+		if (!PSP_IsInited() || !__KernelIsRunning()) {
+			reject("No active game for state evidence");
+			return;
+		}
+		SlotEvidence evidence;
+		evidence.requestID = std::move(requestID);
+		evidence.slot = slot;
+		evidence.discID = g_paramSFO.GetValueString("DISC_ID");
+		evidence.discVersion = g_paramSFO.GetValueString("DISC_VERSION");
+		evidence.gamePath = PSP_CoreParameter().fileToStart;
+		if (!ProjectEvidenceID(evidence.discID, 32, false) || !ProjectEvidenceID(evidence.discVersion, 32, true) ||
+			evidence.gamePath.empty() || evidence.gamePath.ToString().size() > 4096) {
+			reject("Unsupported game identity for state evidence");
+			return;
+		}
+		evidence.gamePrefix = GetGamePrefix(g_paramSFO);
+		evidence.statePath = GenerateSaveSlotPath(evidence.gamePrefix, slot, STATE_EXTENSION);
+		evidence.upstreamCommit = "d357e6a32934800d3d80b49f910a603e1b069751";
+		evidence.extensionID = "trimui-slot-evidence-v1";
+		evidence.engineVersion = PPSSPP_GIT_VERSION;
+		evidence.stateFormatID = "ppsspp:d357e6a32934800d3d80b49f910a603e1b069751:chunk5-savestart3";
+#if defined(__aarch64__)
+		evidence.architecture = "aarch64";
+#elif defined(__x86_64__)
+		evidence.architecture = "x86_64";
+#else
+		reject("Unsupported state evidence architecture");
+		return;
+#endif
+		const uint64_t maxGameBytes = 8ULL * 1024 * 1024 * 1024;
+		const uint64_t maxEngineBytes = 512ULL * 1024 * 1024;
+		ProjectFileFingerprint gameBefore, engineBefore;
+		if (evidence.statePath.empty() || evidence.statePath.size() > 4096 || !ProjectFingerprintFile(evidence.gamePath, maxGameBytes, &gameBefore) ||
+			!ProjectFingerprintFile(Path("/proc/self/exe"), maxEngineBytes, &engineBefore)) {
+			reject("Cannot fingerprint active game and engine");
+			return;
+		}
+		const uint64_t generation = projectEvidenceGeneration.load();
+		auto delivered = std::make_shared<std::atomic<bool>>(false);
+		SaveSlot(evidence.gamePrefix, slot, [evidence, gameBefore, engineBefore, generation, delivered, callback](Status status, std::string_view message) mutable {
+			if (delivered->exchange(true))
+				return;
+			auto fail = [&callback](const char *reason) { callback(Status::FAILURE, reason, nullptr); };
+			if (status != Status::SUCCESS) {
+				callback(Status::FAILURE, message, nullptr);
+				return;
+			}
+			if (projectEvidenceGeneration.load() != generation || !PSP_IsInited() || !__KernelIsRunning() ||
+				PSP_CoreParameter().fileToStart != evidence.gamePath || GetGamePrefix(g_paramSFO) != evidence.gamePrefix ||
+				g_paramSFO.GetValueString("DISC_ID") != evidence.discID || g_paramSFO.GetValueString("DISC_VERSION") != evidence.discVersion) {
+				fail("Game session changed before state evidence completed");
+				return;
+			}
+			ProjectFileFingerprint gameAfter, engineAfter, state;
+			if (!ProjectFingerprintFile(evidence.gamePath, 8ULL * 1024 * 1024 * 1024, &gameAfter) ||
+				!ProjectFingerprintFile(Path("/proc/self/exe"), 512ULL * 1024 * 1024, &engineAfter) ||
+				!(gameBefore == gameAfter) || !(engineBefore == engineAfter) ||
+				!ProjectFingerprintFile(evidence.statePath, 512ULL * 1024 * 1024, &state)) {
+				fail("State, game or engine fingerprint failed");
+				return;
+			}
+			evidence.gameSHA256 = gameAfter.sha256;
+			evidence.gameSize = gameAfter.size;
+			evidence.engineSHA256 = engineAfter.sha256;
+			evidence.engineSize = engineAfter.size;
+			evidence.stateSHA256 = state.sha256;
+			evidence.stateSize = state.size;
+			callback(Status::SUCCESS, message, &evidence);
+		});
+	}
+
