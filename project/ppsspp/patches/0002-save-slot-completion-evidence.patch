+	// Optional in-process qualification API. No file exporter, external command,
+	// save-and-quit behavior or clean-shutdown proof is implied. This hashes the
+	// complete ROM before/after the asynchronous save and may block for large ISOs.
+	// Call only from the existing emulator owner on the emulation thread. Linux SDL
+	// only; other platforms reject. Unsupported/missing DISC_ID or DISC_VERSION,
+	// directory-based games, and unavailable completion cannot produce evidence.
+	struct SlotEvidence {
+		std::string requestID;
+		std::string gamePrefix;
+		std::string discID;
+		std::string discVersion;
+		Path gamePath;
+		Path statePath;
+		std::string upstreamCommit;
+		std::string extensionID;
+		std::string engineVersion;
+		std::string architecture;
+		std::string stateFormatID;
+		std::string engineSHA256;
+		std::string gameSHA256;
+		std::string stateSHA256;
+		uint64_t engineSize = 0;
+		uint64_t gameSize = 0;
+		uint64_t stateSize = 0;
+		int slot = -1;
+	};
+	// Copy evidence during the callback; its pointer is valid only for that call.
+	// FAILURE always has a null evidence pointer. Callbacks may run synchronously
+	// for rejection or on the existing asynchronous SaveState completion thread.
+	using SlotEvidenceCallback = std::function<void(Status, std::string_view, const SlotEvidence *)>;
+	void SaveSlotWithEvidence(int slot, std::string requestID, SlotEvidenceCallback callback);
