+	bool ConfigureProjectStateSessionArgs(int argc, const char *argv[], std::string *error) {
+		std::string option, state;
+		bool seen = false, duplicateState = false;
+		for (int i = 1; i < argc; ++i) {
+			std::string_view value(argv[i]);
+			if (value.substr(0, 24) == "--project-state-session=") {
+				if (seen) { *error = "Duplicate project state session"; return false; }
+				seen = true;
+				option = value.substr(24);
+			}
+			if (value.substr(0, 8) == "--state=") {
+				if (!state.empty())
+					duplicateState = true;
+				state = value.substr(8);
+			}
+		}
+		if (!seen)
+			return true;
+		std::shared_ptr<ProjectStateSession> configured;
+		if (duplicateState || !ProjectLoadSession(Path(option), &configured) ||
+			(configured->request[10] == "resume" ? state != configured->request[11] : !state.empty())) {
+			*error = "Invalid or mismatched private project state session";
+			return false;
+		}
+		std::lock_guard<std::mutex> guard(projectSessionMutex);
+		if (projectSession) { *error = "Project state session already configured"; return false; }
+		projectSession = std::move(configured);
+		return true;
+	}
+
+	bool ProjectStateSessionHandlesLoad() {
+		std::lock_guard<std::mutex> guard(projectSessionMutex);
+		return projectSession && projectSession->request[10] == "resume";
+	}
+
+	static bool ProjectExportResult(const std::shared_ptr<ProjectStateSession> &session, const char *operation,
+		uint64_t sequence, Status status, std::string_view message, const SlotEvidence *evidence) {
+#if defined(SDL) && defined(__linux__)
+		std::string_view operationName(operation);
+		if (status == Status::SUCCESS && (!evidence || (operationName != "save" && operationName != "load")))
+			return false;
+		if (status != Status::SUCCESS)
+			evidence = nullptr;
+		std::vector<std::string> fields(session->request.begin(), session->request.begin() + 6);
+		fields.insert(fields.end(), {operation, std::to_string(sequence), status == Status::SUCCESS ? "success" : "failure",
+			std::string(message.substr(0, 256))});
+		if (evidence) {
+			const auto &e = *evidence;
+			fields.insert(fields.end(), {e.discID, e.discVersion, e.gamePrefix, e.gamePath.ToString(), e.engineSHA256,
+				e.gameSHA256, e.stateSHA256, std::to_string(e.engineSize), std::to_string(e.gameSize), std::to_string(e.stateSize),
+				e.statePath.ToString(), std::to_string(e.slot), e.upstreamCommit, e.extensionID, e.engineVersion, e.architecture, e.stateFormatID});
+		} else {
+			fields.resize(27);
+		}
+		std::string packet = ProjectMakePacket("TPSE1R\n", fields);
+		if (packet.empty())
+			return false;
+		auto publish = [&](const char *name) {
+			std::string temporary = std::string(name) + ".tmp";
+			unlinkat(session->directory, temporary.c_str(), 0);
+			int output = openat(session->directory, temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+			if (output < 0)
+				return false;
+			size_t at = 0;
+			while (at < packet.size()) {
+				ssize_t count = write(output, packet.data() + at, packet.size() - at);
+				if (count <= 0)
+					break;
+				at += (size_t)count;
+			}
+			bool ok = at == packet.size() && fsync(output) == 0;
+			if (close(output) != 0)
+				ok = false;
+			if (!ok || renameat(session->directory, temporary.c_str(), session->directory, name) != 0)
+				return false;
+			return fsync(session->directory) == 0;
+		};
+		// Retain completed save/load identities independently. Later failures
+		// report their own status without erasing a genuinely completed state.
+		// The final result bounds eligible completion sequences: a publication
+		// interrupted before this final record cannot promote a newer receipt.
+		if (status == Status::SUCCESS && !publish(operationName == "save" ? "save-completed" : "load-completed"))
+			return false;
+		return publish("result");
+#else
+		return false;
+#endif
+	}
