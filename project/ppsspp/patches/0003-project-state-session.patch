+	static bool ProjectQueueSlot(std::string_view prefix, int slot, Callback callback) {
+		bool busy = false;
+		{
+			std::lock_guard<std::mutex> guard(projectSessionMutex);
+			if (!projectSession)
+				return false;
+			busy = projectSession->pending.size() >= 4 || prefix.empty() || prefix.size() > 96 || slot < 0 || slot > 99;
+			if (!busy)
+				projectSession->pending.push_back({std::string(prefix), slot, callback});
+		}
+		if (busy && callback)
+			callback(Status::FAILURE, "Project state queue is full");
+		return true;
+	}
+
+	void SaveSlot(std::string_view gamePrefix, int slot, Callback callback) {
+		if (!ProjectQueueSlot(gamePrefix, slot, callback))
+			SaveSlotInternal(gamePrefix, slot, callback);
+	}
+
+	static void ProjectServiceStateSession() {
+		std::shared_ptr<ProjectStateSession> session;
+		ProjectStateSession::Pending pending;
+		bool load = false;
+		{
+			std::lock_guard<std::mutex> guard(projectSessionMutex);
+			session = projectSession;
+			if (!session)
+				return;
+			if (session->request[10] == "resume" && !session->loadStarted) {
+				session->loadStarted = true;
+				load = true;
+			} else {
+				if (session->pending.empty())
+					return;
+				pending = std::move(session->pending.front());
+				session->pending.erase(session->pending.begin());
+			}
+		}
+		uint64_t sequence = ++session->sequence;
+		auto finish = [session, sequence, load, callback = pending.callback](Status status, std::string_view message, const SlotEvidence *evidence) {
+			const auto &r = session->request;
+			if (evidence && (evidence->engineSHA256 != r[8] || evidence->gameSHA256 != r[7] ||
+				evidence->gamePath.ToString() != r[6] || evidence->statePath.ToString().rfind(r[9] + "/", 0) != 0)) {
+				status = Status::FAILURE; evidence = nullptr; message = "Project state identity mismatch";
+			}
+			if (!ProjectExportResult(session, load ? "load" : "save", sequence, status, message, evidence)) {
+				status = Status::FAILURE; message = "Project state result export failed";
+			}
+			if (callback)
+				callback(status, message);
+		};
+		if (session->engineGeneration == 0)
+			session->engineGeneration = projectEvidenceGeneration.load();
+		if (session->engineGeneration != projectEvidenceGeneration.load()) {
+			finish(Status::FAILURE, "Project emulator session changed", nullptr);
+			return;
+		}
+		if (!load) {
+			if (pending.prefix != GetGamePrefix(g_paramSFO)) {
+				finish(Status::FAILURE, "Project state game prefix changed", nullptr);
+				return;
+			}
+			SaveSlotWithEvidence(pending.slot, session->request[1], finish);
+			return;
+		}
+		// Resume uses the actual pinned --state= path and SaveState::Load API.
+		const auto &r = session->request;
+		ProjectFileFingerprint game, engine, state;
+		Path path(r[11]);
+		if (!PSP_IsInited() || !__KernelIsRunning() || PSP_CoreParameter().fileToStart.ToString() != r[6] ||
+			!ProjectFingerprintFile(PSP_CoreParameter().fileToStart, 8ULL * 1024 * 1024 * 1024, &game) || game.sha256 != r[7] ||
+			!ProjectFingerprintFile(Path("/proc/self/exe"), 512ULL * 1024 * 1024, &engine) || engine.sha256 != r[8] ||
+			!ProjectFingerprintFile(path, 512ULL * 1024 * 1024, &state) || state.sha256 != r[12]) {
+			finish(Status::FAILURE, "Project resume input identity mismatch", nullptr);
+			return;
+		}
+		SlotEvidence evidence;
+		evidence.requestID = r[1]; evidence.gamePath = PSP_CoreParameter().fileToStart; evidence.statePath = path;
+		evidence.discID = g_paramSFO.GetValueString("DISC_ID"); evidence.discVersion = g_paramSFO.GetValueString("DISC_VERSION");
+		evidence.gamePrefix = GetGamePrefix(g_paramSFO); evidence.slot = (r[14][0] - '0') * (r[14].size() == 2 ? 10 : 1) + (r[14].size() == 2 ? r[14][1] - '0' : 0);
+		evidence.upstreamCommit = "d357e6a32934800d3d80b49f910a603e1b069751";
+		evidence.extensionID = "trimui-slot-evidence-v1"; evidence.engineVersion = PPSSPP_GIT_VERSION;
+		evidence.stateFormatID = r[13]; evidence.engineSHA256 = engine.sha256; evidence.engineSize = engine.size;
+		evidence.gameSHA256 = game.sha256; evidence.gameSize = game.size; evidence.stateSHA256 = state.sha256; evidence.stateSize = state.size;
+#if defined(__aarch64__)
+		evidence.architecture = "aarch64";
+#elif defined(__x86_64__)
+		evidence.architecture = "x86_64";
+#endif
+		uint64_t generation = projectEvidenceGeneration.load();
+		Load(path, evidence.slot, [evidence, generation, finish](Status status, std::string_view message) {
+			ProjectFileFingerprint currentGame, currentEngine, currentState;
+			bool valid = status == Status::SUCCESS && generation == projectEvidenceGeneration.load() &&
+				PSP_IsInited() && __KernelIsRunning() && PSP_CoreParameter().fileToStart == evidence.gamePath &&
+				GetGamePrefix(g_paramSFO) == evidence.gamePrefix &&
+				ProjectFingerprintFile(evidence.gamePath, 8ULL * 1024 * 1024 * 1024, &currentGame) && currentGame.sha256 == evidence.gameSHA256 &&
+				ProjectFingerprintFile(Path("/proc/self/exe"), 512ULL * 1024 * 1024, &currentEngine) && currentEngine.sha256 == evidence.engineSHA256 &&
+				ProjectFingerprintFile(evidence.statePath, 512ULL * 1024 * 1024, &currentState) && currentState.sha256 == evidence.stateSHA256;
+			finish(valid ? Status::SUCCESS : Status::FAILURE, message, valid ? &evidence : nullptr);
+		});
+	}
