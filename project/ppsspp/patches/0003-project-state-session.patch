+	static bool ProjectParsePacket(std::string_view packet, const char *magic, size_t count, std::vector<std::string> *fields) {
+		std::string_view prefix(magic);
+		if (packet.size() > 32768 || packet.substr(0, prefix.size()) != prefix)
+			return false;
+		size_t at = prefix.size();
+		std::vector<std::string> result;
+		for (size_t item = 0; item < count; ++item) {
+			size_t colon = packet.find(':', at);
+			if (colon == std::string_view::npos || colon == at || colon - at > 5 ||
+				(colon - at > 1 && packet[at] == '0'))
+				return false;
+			size_t length = 0;
+			for (; at < colon; ++at) {
+				if (packet[at] < '0' || packet[at] > '9')
+					return false;
+				length = length * 10 + packet[at] - '0';
+			}
+			at = colon + 1;
+			if (length > 8192 || length >= packet.size() - at || packet[at + length] != ',')
+				return false;
+			result.emplace_back(packet.substr(at, length));
+			if (result.back().find('\0') != std::string::npos)
+				return false;
+			at += length + 1;
+		}
+		if (at != packet.size())
+			return false;
+		*fields = std::move(result);
+		return true;
+	}
+
+	static std::string ProjectMakePacket(const char *magic, const std::vector<std::string> &fields) {
+		std::string result(magic);
+		for (const auto &field : fields) {
+			if (field.size() > 8192 || field.find('\0') != std::string::npos)
+				return "";
+			result += std::to_string(field.size()) + ":" + field + ",";
+		}
+		return result.size() <= 32768 ? result : "";
+	}
+
+	static bool ProjectHex(std::string_view value, size_t size) {
+		return value.size() == size && std::all_of(value.begin(), value.end(), [](char c) {
+			return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+		});
+	}
+
+	static bool ProjectDecimal(std::string_view value, uint64_t max, uint64_t *number) {
+		if (value.empty() || value.size() > 16 || (value.size() > 1 && value[0] == '0'))
+			return false;
+		uint64_t result = 0;
+		for (char c : value) {
+			if (c < '0' || c > '9' || result > (max - (uint64_t)(c - '0')) / 10)
+				return false;
+			result = result * 10 + c - '0';
+		}
+		*number = result;
+		return result <= max;
+	}
+
+	static bool ProjectAbsolute(std::string_view path) {
+		if (path.empty() || path[0] != '/' || path.size() > 4096 || path.find('\0') != std::string_view::npos)
+			return false;
+		size_t at = 1;
+		while (at < path.size()) {
+			size_t end = path.find('/', at);
+			if (end == std::string_view::npos)
+				end = path.size();
+			auto part = path.substr(at, end - at);
+			if (part.empty() || part == "." || part == "..")
+				return false;
+			at = end + 1;
+		}
+		return path.back() != '/';
+	}
+
+	static bool ProjectLoadSession(const Path &requestPath, std::shared_ptr<ProjectStateSession> *session) {
+#if defined(SDL) && defined(__linux__)
+		std::string path = requestPath.ToString();
+		if (!ProjectAbsolute(path) || path.size() < 9 || path.substr(path.size() - 8) != "/request")
+			return false;
+		std::string parent = path.substr(0, path.size() - 8);
+		// Open every directory component without following symlinks.
+		int directory = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (directory < 0)
+			return false;
+		size_t at = 1;
+		while (at < parent.size()) {
+			size_t end = parent.find('/', at);
+			if (end == std::string::npos)
+				end = parent.size();
+			std::string component = parent.substr(at, end - at);
+			int next = openat(directory, component.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+			close(directory);
+			if (next < 0)
+				return false;
+			directory = next;
+			at = end + 1;
+		}
+		auto result = std::make_shared<ProjectStateSession>();
+		result->directory = directory;
+		struct stat owner{};
+		if (fstat(directory, &owner) != 0 || owner.st_uid != getuid() || (owner.st_mode & 0777) != 0700)
+			return false;
+		int input = openat(directory, "request", O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+		if (input < 0)
+			return false;
+		struct stat before{}, after{};
+		if (fstat(input, &before) != 0 || !S_ISREG(before.st_mode) || before.st_uid != getuid() ||
+			(before.st_mode & 0777) != 0600 || before.st_nlink != 1 || before.st_size <= 0 || before.st_size > 32768) {
+			close(input);
+			return false;
+		}
+		std::string packet((size_t)before.st_size, '\0');
+		size_t total = 0;
+		while (total < packet.size()) {
+			ssize_t count = read(input, &packet[total], packet.size() - total);
+			if (count <= 0)
+				break;
+			total += (size_t)count;
+		}
+		bool stable = total == packet.size() && fstat(input, &after) == 0 && before.st_size == after.st_size &&
+			before.st_mtim.tv_sec == after.st_mtim.tv_sec && before.st_mtim.tv_nsec == after.st_mtim.tv_nsec &&
+			before.st_ctim.tv_sec == after.st_ctim.tv_sec && before.st_ctim.tv_nsec == after.st_ctim.tv_nsec;
+		close(input);
+		if (!stable || !ProjectParsePacket(packet, "TPSE1Q\n", 15, &result->request))
+			return false;
+		auto &r = result->request;
+		uint64_t generation, slot;
+		if (!ProjectHex(r[0], 32) || !ProjectHex(r[1], 32) || !ProjectHex(r[2], 32) ||
+			!ProjectEvidenceID(r[3], 64, false) || !ProjectDecimal(r[4], 1000000000000000ULL, &generation) ||
+			r[5].empty() || r[5].size() > 192 || !ProjectAbsolute(r[6]) || !ProjectHex(r[7], 64) ||
+			!ProjectHex(r[8], 64) || !ProjectAbsolute(r[9]) || (r[10] != "save" && r[10] != "resume") ||
+			r[13] != "ppsspp:d357e6a32934800d3d80b49f910a603e1b069751:chunk5-savestart3" ||
+			!ProjectDecimal(r[14], 99, &slot))
+			return false;
+		if (r[10] == "save" ? (!r[11].empty() || !r[12].empty()) :
+			(!ProjectAbsolute(r[11]) || !ProjectHex(r[12], 64) || r[11].rfind(r[9] + "/", 0) != 0))
+			return false;
+		ProjectFileFingerprint engine;
+		if (!ProjectFingerprintFile(Path("/proc/self/exe"), 512ULL * 1024 * 1024, &engine) || engine.sha256 != r[8])
+			return false;
+		*session = std::move(result);
+		return true;
+#else
+		return false;
+#endif
+	}
