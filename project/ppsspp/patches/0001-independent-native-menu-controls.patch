--- /dev/null
+++ b/Core/ProjectNativeMenuControls.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Project modification for the Smart Pro spruce offshoot, 2026.
+// Uses PPSSPP input key codes; distributed with the PPSSPP GPL-2.0-or-later
+// source and notices. This extension is not an upstream PPSSPP setting.
+#pragma once
+
+#include <string_view>
+#include "Common/Input/KeyCodes.h"
+
+namespace KeyMap {
+
+// "south" and "east" describe SDL positional buttons, not printed A/B labels.
+// SDLJoystick.cpp translates SDL A/B to PPSSPP BUTTON_2/BUTTON_3.
+// Malformed/equal choices fail closed to the caller's original menu policy.
+// No controller mapping or emulated PSP system parameter is modified here.
+inline bool ResolveProjectNativeMenuKeys(bool enabled, std::string_view confirm,
+	std::string_view back, int *confirmKey, int *backKey) {
+#if !defined(SDL)
+	// This extension is qualified only against PPSSPP's SDL input translation.
+	(void)enabled; (void)confirm; (void)back; (void)confirmKey; (void)backKey;
+	return false;
+#else
+	if (!enabled || !confirmKey || !backKey)
+		return false;
+	if (confirm == "south" && back == "east") {
+		*confirmKey = NKCODE_BUTTON_2;
+		*backKey = NKCODE_BUTTON_3;
+		return true;
+	}
+	if (confirm == "east" && back == "south") {
+		*confirmKey = NKCODE_BUTTON_3;
+		*backKey = NKCODE_BUTTON_2;
+		return true;
+	}
+	return false;
+#endif
+}
+
+}  // namespace KeyMap
