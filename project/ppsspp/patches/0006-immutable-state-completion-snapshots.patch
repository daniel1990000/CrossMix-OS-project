+		struct stat rootInfo{};
+		if (fstat(root.fd, &rootInfo) != 0 || !S_ISDIR(rootInfo.st_mode) ||
+			rootInfo.st_uid != getuid() || (rootInfo.st_mode & 0022) != 0)
