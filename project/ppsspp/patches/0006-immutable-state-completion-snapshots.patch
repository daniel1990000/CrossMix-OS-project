+	// Optional immutable completion payloads. Existing native slots and Undo stay
+	// native-owned; a receipt never points at those subsequently mutable bytes.
+	static bool ProjectSnapshotState(const std::shared_ptr<ProjectStateSession> &session,
+		uint64_t sequence, const SlotEvidence &evidence, SlotEvidence *snapshot) {
+#if defined(SDL) && defined(__linux__)
+		constexpr uint64_t maxBytes = 512ULL * 1024 * 1024;
+		constexpr size_t maxFiles = 32;
+		struct OwnedFD {
+			int fd;
+			~OwnedFD() { if (fd >= 0) close(fd); }
+		};
+		// Resolve every root component without symlinks, as for the transport.
+		const std::string &rootName = session->request[9];
+		OwnedFD root{open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC)};
+		if (root.fd < 0) return false;
+		for (size_t at = 1; at < rootName.size();) {
+			size_t end = rootName.find('/', at);
+			if (end == std::string::npos) end = rootName.size();
+			std::string part = rootName.substr(at, end - at);
+			int next = openat(root.fd, part.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+			if (next < 0) return false;
+			close(root.fd); root.fd = next; at = end + 1;
