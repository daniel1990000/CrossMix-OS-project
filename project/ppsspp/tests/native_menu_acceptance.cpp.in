/*@@INPUT_DEVICE@@*/
/*@@INPUT_MAPPING@@*/
/*@@PSP_CONSTANTS@@*/
using u32 = uint32_t;
using s32 = int32_t;
/*@@VIRTUAL_KEYS@@*/
/*@@UI_STATE@@*/
/*@@KEY_FLAGS@@*/
constexpr bool operator&(KeyInputFlags a, KeyInputFlags b) {
    return (static_cast<int>(a) & static_cast<int>(b)) != 0;
}
/*@@KEY_INPUT@@*/

enum SDL_GameControllerButton {
    SDL_CONTROLLER_BUTTON_INVALID = -1,
    SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B,
    SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y,
    SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_DOWN,
    SDL_CONTROLLER_BUTTON_DPAD_LEFT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT,
    SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER,
    SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_BACK,
    SDL_CONTROLLER_BUTTON_GUIDE, SDL_CONTROLLER_BUTTON_LEFTSTICK,
    SDL_CONTROLLER_BUTTON_RIGHTSTICK,
};
class SDLJoystick {
public:
    InputKeyCode getKeycodeForButton(SDL_GameControllerButton button);
};
/*@@SDL_TRANSLATOR@@*/

struct Config {
/*@@CONFIG_MEMBERS@@*/
    int iButtonPreference = PSP_SYSTEMPARAM_BUTTON_CROSS;
    bool bForceVR = false;
    bool bPauseExitsEmulator = false;
} g_Config;

namespace KeyMap {
// These explicitly stub unrelated input storage and platform callbacks. The
// production menu policy and SDL key translator below remain the actual source.
std::map<int, std::vector<InputMapping>> gameplay;
std::set<InputDeviceID> g_seenDeviceIds;
std::vector<InputMapping> capturedConfirm, capturedCancel, capturedInfo;
std::vector<InputMapping> capturedLeftTab, capturedRightTab;
std::vector<std::vector<InputMapping>> capturedDpad;
std::unordered_map<InputDeviceID, int> capturedFlips;
struct AnalogAxis { int direction; };
struct AnalogMappings { AnalogAxis leftY; };
AnalogMappings MappedAxesForDevice(InputDeviceID id) { return {{id == DEVICE_ID_PAD_0 ? -1 : 1}}; }
void SingleInputMappingFromPspButton(int button, std::vector<InputMapping> *output, bool ignoreMouse) {
    assert(ignoreMouse);
    *output = gameplay[button];
}
void SetDPadKeys(const std::vector<InputMapping> &up, const std::vector<InputMapping> &down,
                const std::vector<InputMapping> &left, const std::vector<InputMapping> &right) {
    capturedDpad = {up, down, left, right};
}
void SetConfirmCancelKeys(const std::vector<InputMapping> &confirm, const std::vector<InputMapping> &cancel) {
    capturedConfirm = confirm; capturedCancel = cancel;
}
void SetTabLeftRightKeys(const std::vector<InputMapping> &left, const std::vector<InputMapping> &right) {
    capturedLeftTab = left; capturedRightTab = right;
}
void SetInfoKeys(const std::vector<InputMapping> &info) { capturedInfo = info; }
void SetAnalogFlipY(const std::unordered_map<InputDeviceID, int> &flips) { capturedFlips = flips; }
bool InputMappingToPspButton(const InputMapping &input, std::vector<int> *buttons) {
    for (const auto &[button, mappings] : gameplay) {
        if (std::find(mappings.begin(), mappings.end(), input) != mappings.end()) buttons->push_back(button);
    }
    return !buttons->empty();
}

/*@@INSERT_MAPPING@@*/
/*@@HAS_MAIN_BUTTON@@*/
/*@@UPDATE_MENU@@*/
}  // namespace KeyMap

// Narrow NativeKey platform stubs. The complete production event function is
// inserted below, including the original PauseExitsEmulator shortcut.
int exitRequests = 0;
GlobalUIState currentUIState = UISTATE_MENU;
GlobalUIState GetUIState() { return currentUIState; }
double time_now_d() { return 0.0; }
bool IsVREnabled() { return false; }
bool UpdateVRKeys(const KeyInput &) { return true; }
void System_ExitApp() { ++exitRequests; }
void ProcessWheelRelease(int, double, bool) {}
namespace HLEPlugins { void SetKey(int, bool) {} }
struct StubScreenManager {
    int calls = 0;
    bool key(const KeyInput &) { ++calls; return true; }
} screenManager;
StubScreenManager *g_screenManager = &screenManager;
/*@@NATIVE_KEY@@*/

using namespace KeyMap;
using ExactKeys = std::vector<std::pair<int, int>>;
ExactKeys exact(const std::vector<InputMapping> &keys) {
    ExactKeys result;
    for (const auto &key : keys) result.emplace_back(key.deviceId, key.keyCode);
    return result;
}
std::map<int, ExactKeys> exactGameplay() {
    std::map<int, ExactKeys> result;
    for (const auto &[button, mappings] : gameplay) result[button] = exact(mappings);
    return result;
}
bool contains(const std::vector<InputMapping> &keys, InputDeviceID device, int code) {
    return std::any_of(keys.begin(), keys.end(), [&](const InputMapping &key) {
        return key.deviceId == device && key.keyCode == code;
    });
}
void reset() {
    g_Config = Config{};
    SDLJoystick translator;
    gameplay = {
        {CTRL_CROSS, {{DEVICE_ID_PAD_0, translator.getKeycodeForButton(SDL_CONTROLLER_BUTTON_A)}}},
        {CTRL_CIRCLE, {{DEVICE_ID_PAD_0, translator.getKeycodeForButton(SDL_CONTROLLER_BUTTON_B)}}},
        {CTRL_TRIANGLE, {{DEVICE_ID_PAD_0, NKCODE_BUTTON_1}}},
        {CTRL_LTRIGGER, {{DEVICE_ID_PAD_0, NKCODE_BUTTON_6}}},
        {CTRL_RTRIGGER, {{DEVICE_ID_PAD_0, NKCODE_BUTTON_5}}},
        {CTRL_UP, {{DEVICE_ID_PAD_0, NKCODE_DPAD_UP}}},
        {CTRL_DOWN, {{DEVICE_ID_PAD_0, NKCODE_DPAD_DOWN}}},
        {CTRL_LEFT, {{DEVICE_ID_PAD_0, NKCODE_DPAD_LEFT}}},
        {CTRL_RIGHT, {{DEVICE_ID_PAD_0, NKCODE_DPAD_RIGHT}}},
    };
    g_seenDeviceIds = {DEVICE_ID_PAD_0, DEVICE_ID_PAD_1};
    exitRequests = 0;
    screenManager.calls = 0;
    currentUIState = UISTATE_MENU;
}
void assertUnchanged(const std::map<int, ExactKeys> &saved, int preference) {
    assert(exactGameplay() == saved);
    assert(g_Config.iButtonPreference == preference);
}

int main(int argc, char **argv) {
    assert(argc == 2);
    const std::string scenario = argv[1];
    reset();
    SDLJoystick translator;
    const int south = translator.getKeycodeForButton(SDL_CONTROLLER_BUTTON_A);
    const int east = translator.getKeycodeForButton(SDL_CONTROLLER_BUTTON_B);
    assert(south == NKCODE_BUTTON_2 && east == NKCODE_BUTTON_3);
    const auto saved = exactGameplay();
    if (scenario == "legacy") {
        assert(!g_Config.bProjectIndependentMenuControls);
        for (int preference : {PSP_SYSTEMPARAM_BUTTON_CROSS, PSP_SYSTEMPARAM_BUTTON_CIRCLE}) {
            g_Config.iButtonPreference = preference;
            UpdateNativeMenuKeys();
            assert(contains(capturedConfirm, DEVICE_ID_PAD_0,
                            preference == PSP_SYSTEMPARAM_BUTTON_CROSS ? south : east));
            assert(contains(capturedCancel, DEVICE_ID_PAD_0,
                            preference == PSP_SYSTEMPARAM_BUTTON_CROSS ? east : south));
            assert(!contains(capturedConfirm, DEVICE_ID_ANY, NKCODE_BUTTON_A));
            assertUnchanged(saved, preference);
        }
    } else if (scenario == "physical") {
        g_Config.bProjectIndependentMenuControls = true;
        for (int preference : {PSP_SYSTEMPARAM_BUTTON_CROSS, PSP_SYSTEMPARAM_BUTTON_CIRCLE}) {
            for (bool southConfirm : {true, false}) {
                g_Config.iButtonPreference = preference;
                g_Config.sProjectNativeMenuConfirm = southConfirm ? "south" : "east";
                g_Config.sProjectNativeMenuBack = southConfirm ? "east" : "south";
                UpdateNativeMenuKeys();
                assert(contains(capturedConfirm, DEVICE_ID_ANY, southConfirm ? south : east));
                assert(contains(capturedCancel, DEVICE_ID_ANY, southConfirm ? east : south));
                assert(!contains(capturedConfirm, DEVICE_ID_ANY, southConfirm ? east : south));
                // ANY matches the built-in pad and another controller using the SDL translation.
                assert(std::find(capturedConfirm.begin(), capturedConfirm.end(),
                                 InputMapping(DEVICE_ID_PAD_1, southConfirm ? south : east)) != capturedConfirm.end());
                assertUnchanged(saved, preference);
            }
        }
    } else if (scenario == "remapped") {
        gameplay[CTRL_CROSS] = {{DEVICE_ID_PAD_0, NKCODE_BUTTON_6}};
        gameplay[CTRL_CIRCLE] = {{DEVICE_ID_PAD_0, NKCODE_BUTTON_5}};
        const auto remapped = exactGameplay();
        g_Config.bProjectIndependentMenuControls = true;
        for (int preference : {PSP_SYSTEMPARAM_BUTTON_CROSS, PSP_SYSTEMPARAM_BUTTON_CIRCLE}) {
            g_Config.iButtonPreference = preference;
            UpdateNativeMenuKeys();
            assert(contains(capturedConfirm, DEVICE_ID_ANY, south));
            assert(contains(capturedCancel, DEVICE_ID_ANY, east));
            assert(!contains(capturedConfirm, DEVICE_ID_PAD_0, NKCODE_BUTTON_6));
            assert(!contains(capturedCancel, DEVICE_ID_PAD_0, NKCODE_BUTTON_5));
            assertUnchanged(remapped, preference);
        }
    } else if (scenario == "malformed") {
        UpdateNativeMenuKeys();
        const auto baselineConfirm = exact(capturedConfirm), baselineCancel = exact(capturedCancel);
        g_Config.bProjectIndependentMenuControls = true;
        for (const auto &pair : std::vector<std::pair<std::string, std::string>>{
                 {"south", "south"}, {"east", "east"}, {"west", "east"},
                 {"SOUTH", "east"}, {"south", ""}, {"", "east"}}) {
            g_Config.sProjectNativeMenuConfirm = pair.first;
            g_Config.sProjectNativeMenuBack = pair.second;
            int confirm = 123, back = 456;
            assert(!ResolveProjectNativeMenuKeys(true, pair.first, pair.second, &confirm, &back));
            assert(confirm == 123 && back == 456);
            UpdateNativeMenuKeys();
            assert(exact(capturedConfirm) == baselineConfirm && exact(capturedCancel) == baselineCancel);
            assertUnchanged(saved, PSP_SYSTEMPARAM_BUTTON_CROSS);
        }
        int confirm = 123, back = 456;
        assert(!ResolveProjectNativeMenuKeys(false, "south", "east", &confirm, &back));
        assert(!ResolveProjectNativeMenuKeys(true, "south", "east", nullptr, &back));
        assert(!ResolveProjectNativeMenuKeys(true, "south", "east", &confirm, nullptr));
        assert(confirm == 123 && back == 456);
    } else if (scenario == "navigation-collisions") {
        for (int action : {CTRL_TRIANGLE, CTRL_LTRIGGER, CTRL_RTRIGGER, CTRL_UP, CTRL_DOWN, CTRL_LEFT, CTRL_RIGHT}) {
            gameplay[action] = {{DEVICE_ID_PAD_0, south}, {DEVICE_ID_PAD_1, east},
                                {DEVICE_ID_PAD_0, NKCODE_BUTTON_6}};
        }
        const auto remapped = exactGameplay();
        UpdateNativeMenuKeys();
        const auto originalInfo = exact(capturedInfo), originalLeft = exact(capturedLeftTab), originalRight = exact(capturedRightTab);
        const auto originalDpad = capturedDpad;
        for (bool southConfirm : {true, false}) {
            g_Config.bProjectIndependentMenuControls = true;
            g_Config.sProjectNativeMenuConfirm = southConfirm ? "south" : "east";
            g_Config.sProjectNativeMenuBack = southConfirm ? "east" : "south";
            UpdateNativeMenuKeys();
            assert(contains(capturedConfirm, DEVICE_ID_ANY, southConfirm ? south : east));
            assert(contains(capturedCancel, DEVICE_ID_ANY, southConfirm ? east : south));
            std::vector<std::vector<InputMapping>> actions = capturedDpad;
            actions.push_back(capturedInfo); actions.push_back(capturedLeftTab); actions.push_back(capturedRightTab);
            for (const auto &keys : actions) {
                assert(!contains(keys, DEVICE_ID_PAD_0, south));
                assert(!contains(keys, DEVICE_ID_PAD_1, east));
                assert(contains(keys, DEVICE_ID_PAD_0, NKCODE_BUTTON_6));
            }
            assertUnchanged(remapped, PSP_SYSTEMPARAM_BUTTON_CROSS);
        }
        for (bool invalid : {true, false}) {
            g_Config.bProjectIndependentMenuControls = invalid;
            g_Config.sProjectNativeMenuConfirm = "south";
            g_Config.sProjectNativeMenuBack = invalid ? "south" : "east";
            UpdateNativeMenuKeys();
            assert(exact(capturedInfo) == originalInfo);
            assert(exact(capturedLeftTab) == originalLeft && exact(capturedRightTab) == originalRight);
            for (size_t i = 0; i < originalDpad.size(); ++i) assert(exact(capturedDpad[i]) == exact(originalDpad[i]));
            assertUnchanged(remapped, PSP_SYSTEMPARAM_BUTTON_CROSS);
        }
    } else if (scenario == "exit-collision" || scenario == "exit-no-sdl") {
        gameplay[VIRTKEY_PAUSE] = {{DEVICE_ID_PAD_0, south}, {DEVICE_ID_PAD_1, east},
                                   {DEVICE_ID_PAD_0, NKCODE_BUTTON_6}};
        const auto remapped = exactGameplay();
        g_Config.bPauseExitsEmulator = true;
        auto press = [](InputDeviceID device, int code) {
            return NativeKey(KeyInput(device, static_cast<InputKeyCode>(code), KeyInputFlags::DOWN));
        };
        for (bool enabled : {true, false}) {
            g_Config.bProjectIndependentMenuControls = enabled;
            for (bool valid : {true, false}) {
                g_Config.sProjectNativeMenuBack = valid ? "east" : "south";
                for (GlobalUIState state : {UISTATE_MENU, UISTATE_PAUSEMENU, UISTATE_INGAME}) {
                    currentUIState = state;
                    exitRequests = 0; screenManager.calls = 0;
                    assert(press(DEVICE_ID_PAD_0, south));
                    assert(press(DEVICE_ID_PAD_1, east));
                    bool reserved = scenario == "exit-collision" && enabled && valid && state != UISTATE_INGAME;
                    assert(exitRequests == (reserved ? 0 : 2));
                    assert(screenManager.calls == (reserved ? 2 : 0));
                    // The unrelated gameplay Pause binding still works everywhere.
                    assert(press(DEVICE_ID_PAD_0, NKCODE_BUTTON_6));
                    assert(exitRequests == (reserved ? 1 : 3));
                    assertUnchanged(remapped, PSP_SYSTEMPARAM_BUTTON_CROSS);
                }
            }
        }
    } else if (scenario == "navigation") {
        UpdateNativeMenuKeys();
        const auto tabsLeft = exact(capturedLeftTab), tabsRight = exact(capturedRightTab), info = exact(capturedInfo);
        const auto dpad = capturedDpad;
        const auto flips = capturedFlips;
        g_Config.bProjectIndependentMenuControls = true;
        g_Config.sProjectNativeMenuConfirm = "east";
        g_Config.sProjectNativeMenuBack = "south";
        UpdateNativeMenuKeys();
        assert(contains(capturedConfirm, DEVICE_ID_KEYBOARD, NKCODE_SPACE));
        assert(contains(capturedConfirm, DEVICE_ID_KEYBOARD, NKCODE_ENTER));
        assert(contains(capturedConfirm, DEVICE_ID_KEYBOARD, NKCODE_NUMPAD_ENTER));
        assert(contains(capturedCancel, DEVICE_ID_KEYBOARD, NKCODE_ESCAPE));
        assert(contains(capturedCancel, DEVICE_ID_ANY, NKCODE_BACK));
        assert(contains(capturedCancel, DEVICE_ID_MOUSE, NKCODE_EXT_MOUSEBUTTON_4));
        assert(exact(capturedLeftTab) == tabsLeft && exact(capturedRightTab) == tabsRight);
        assert(exact(capturedInfo) == info && capturedFlips == flips);
        assert(capturedDpad.size() == dpad.size());
        for (size_t i = 0; i < dpad.size(); ++i) assert(exact(capturedDpad[i]) == exact(dpad[i]));
        assertUnchanged(saved, PSP_SYSTEMPARAM_BUTTON_CROSS);
    } else if (scenario == "no-sdl") {
        UpdateNativeMenuKeys();
        const auto baselineConfirm = exact(capturedConfirm), baselineCancel = exact(capturedCancel);
        g_Config.bProjectIndependentMenuControls = true;
        g_Config.sProjectNativeMenuConfirm = "east";
        g_Config.sProjectNativeMenuBack = "south";
        UpdateNativeMenuKeys();
        assert(exact(capturedConfirm) == baselineConfirm && exact(capturedCancel) == baselineCancel);
        assertUnchanged(saved, PSP_SYSTEMPARAM_BUTTON_CROSS);
    } else {
        return 2;
    }
    std::cout << "PASS " << scenario << '\n';
}
