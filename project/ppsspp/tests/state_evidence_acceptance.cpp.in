enum class PathType { NATIVE, CONTENT_URI };
struct Path {
	std::string value;
	Path() = default;
	explicit Path(std::string value_) : value(std::move(value_)) {}
	bool empty() const { return value.empty(); }
	bool IsAbsolute() const { return !value.empty() && value.front() == '/'; }
	size_t size() const { return value.size(); }
	const char *c_str() const { return value.c_str(); }
	const std::string &ToString() const { return value; }
	std::string ToVisualString() const { return value; }
	PathType Type() const { return value.rfind("content://", 0) == 0 ? PathType::CONTENT_URI : PathType::NATIVE; }
	Path operator/(std::string_view name) const { return Path(value + "/" + std::string(name)); }
	Path WithExtraExtension(std::string_view ext) const { return Path(value + std::string(ext)); }
	bool operator==(const Path &other) const { return value == other.value; }
	bool operator!=(const Path &other) const { return value != other.value; }
};

static bool failFinalRename = false;
static bool emptyFinalState = false;
static int screenshotCount = 0;
static Path stateDirectory;
namespace File {
bool Exists(const Path &path) { return std::filesystem::exists(path.value); }
bool Delete(const Path &path, bool) { return std::filesystem::remove(path.value); }
bool Rename(const Path &from, const Path &to) {
	if (failFinalRename && from.value.size() >= 4 && from.value.substr(from.value.size() - 4) == ".tmp")
		return false;
	std::error_code error;
	std::filesystem::rename(from.value, to.value, error);
	if (emptyFinalState && !error)
		std::ofstream(to.value, std::ios::trunc);
	return !error;
}
bool CreateFullPath(const Path &path) { std::filesystem::create_directories(path.value); return true; }
}

static const int DIRECTORY_SAVESTATE = 1;
Path GetSysDirectory(int) { return stateDirectory; }
template<typename... Args>
std::string StringFromFormat(const char *format, Args... args) {
	char output[512];
	snprintf(output, sizeof(output), format, args...);
	return output;
}

