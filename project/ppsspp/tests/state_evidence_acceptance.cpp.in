// These stubs replace the complete emulator and serializer. They never claim
// that the fixture bytes are a real PSP save state or prove file-system durability.
class PointerWrap;
static std::string serializedStateBytes = "fixture state bytes\n";
class CChunkFileReader {
public:
	enum Error { ERROR_NONE, ERROR_BROKEN_STATE, ERROR_OTHER };
	static Error result;
	template<class State> static Error Save(const Path &path, const std::string &, const char *, State &) {
		if (result == ERROR_NONE)
			std::ofstream(path.value, std::ios::binary | std::ios::trunc) << serializedStateBytes;
		return result;
	}
	template<class State> static Error Load(const Path &, std::string *, State &, std::string *) { return result; }
	template<class State> static Error Verify(State &) { return result; }
};
CChunkFileReader::Error CChunkFileReader::result = CChunkFileReader::ERROR_NONE;

