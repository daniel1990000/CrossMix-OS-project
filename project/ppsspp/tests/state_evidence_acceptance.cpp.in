int main(int argc, char **argv) {
	assert(argc == 3);
	std::string scenario(argv[1]);
	std::filesystem::path work(argv[2]);
	stateDirectory = Path((work / "states").string());
	std::filesystem::create_directories(stateDirectory.value);
	coreParameter.fileToStart = Path((work / "game ü.iso").string());
	std::ofstream(coreParameter.fileToStart.value, std::ios::binary) << "fixture ROM bytes\n";
	using namespace SaveState;
	Init();
	int callbacks = 0;
	bool success = false;
	SlotEvidence retained;
	auto callback = [&](Status status, std::string_view, const SlotEvidence *evidence) {
		++callbacks;
		assert((status == Status::SUCCESS) == (evidence != nullptr));
		if (evidence) {
			success = true;
			retained = *evidence;
		}
	};
	int slot = scenario == "bad-slot" ? 100 : 2;
	std::string request = scenario == "bad-request" ? "../bad" : "request-123";
	if (scenario == "missing-disc")
		g_paramSFO.data.erase("DISC_ID");
	if (scenario == "inactive")
		initialized = false;
	if (scenario == "network-slot")
		networkRejectCall = 1;
	if (scenario == "network-save")
		networkRejectCall = 2;
	if (scenario == "network-queue")
		networkRejectCall = 3;
	if (scenario == "hardcore")
		hardcore = true;
	if (scenario == "hardcore-save-allowed") {
		hardcore = true;
		g_Config.bAchievementsSaveStateInHardcoreMode = true;
	}
	if (scenario == "rom-directory") {
		std::filesystem::remove(coreParameter.fileToStart.value);
		std::filesystem::create_directory(coreParameter.fileToStart.value);
	}
	if (scenario == "rom-fifo") {
		std::filesystem::remove(coreParameter.fileToStart.value);
		assert(mkfifo(coreParameter.fileToStart.c_str(), 0600) == 0);
	}
	if (scenario == "rom-oversize")
		std::filesystem::resize_file(coreParameter.fileToStart.value, 8ULL * 1024 * 1024 * 1024 + 1);
	if (scenario == "rom-empty")
		std::filesystem::resize_file(coreParameter.fileToStart.value, 0);
	SaveSlotWithEvidence(slot, request, callback);
	bool immediate = scenario == "bad-request" || scenario == "bad-slot" || scenario == "missing-disc" ||
		scenario == "inactive" || scenario == "rom-directory" || scenario == "rom-fifo" ||
		scenario == "rom-oversize" || scenario == "rom-empty" || scenario == "network-slot" ||
		scenario == "network-save" || scenario == "network-queue" || scenario == "hardcore";
#ifndef SDL
	immediate = true;
#endif
	if (immediate) {
		assert(callbacks == 1 && !success && g_pendingOperations.empty());
		return 0;
	}
	assert(callbacks == 0);
	assert(g_pendingOperations.size() == 1);
	assert(!success);  // Enqueued is not completed.
	assert(screenshotCount == 1);  // A screenshot request is not state success.
	if (scenario == "unprocessed") {
		assert(callbacks == 0 && !File::Exists(GenerateSaveSlotPath(GetGamePrefix(g_paramSFO), slot, STATE_EXTENSION)));
		return 0;
	}
	if (scenario == "write-failure")
		CChunkFileReader::result = CChunkFileReader::ERROR_OTHER;
	if (scenario == "rename-failure")
		failFinalRename = true;
	if (scenario == "empty-state")
		emptyFinalState = true;
	if (scenario == "rom-changed")
		std::ofstream(coreParameter.fileToStart.value, std::ios::app) << "changed";
	if (scenario == "rom-replaced") {
		Path replacement = coreParameter.fileToStart.WithExtraExtension(".replacement");
		std::ofstream(replacement.value, std::ios::binary) << "different ROM data";
		assert(std::filesystem::file_size(replacement.value) == 18);
		std::filesystem::rename(replacement.value, coreParameter.fileToStart.value);
	}
	if (scenario == "disc-changed")
		g_paramSFO.data["DISC_VERSION"] = "1.01";
	if (scenario == "game-path-changed")
		coreParameter.fileToStart = Path((work / "different.iso").string());
	if (scenario == "reinitialized")
		Init();
	if (scenario == "shutdown")
		Shutdown();
	if (scenario == "kernel-lost")
		kernelRunning = false;
	auto duplicatedCompletion = g_pendingOperations.front().callback;
	Process();
	if (scenario == "kernel-lost") {
		assert(callbacks == 0 && !success);
		assert(!File::Exists(GenerateSaveSlotPath(GetGamePrefix(g_paramSFO), slot, STATE_EXTENSION)));
		return 0;
	}
	assert(callbacks == 1);
	if (scenario == "success" || scenario == "hardcore-save-allowed") {
		assert(success);
		assert(retained.requestID == "request-123" && retained.slot == 2);
		assert(retained.discID == "ULUS12345" && retained.discVersion == "1.00");
		assert(retained.gamePrefix == "ULUS12345_1.00");
		assert(retained.statePath.value == (work / "states/ULUS12345_1.00_2.ppst").string());
		assert(retained.gamePath == coreParameter.fileToStart);
		assert(retained.gameSize == 18 && retained.stateSize == 20 && retained.engineSize > 0);
		assert(retained.engineVersion == PPSSPP_GIT_VERSION);
		assert(retained.upstreamCommit == "d357e6a32934800d3d80b49f910a603e1b069751");
		assert(retained.extensionID == "trimui-slot-evidence-v1");
		assert(retained.architecture == "x86_64" || retained.architecture == "aarch64");
		std::cout << "engine=" << retained.engineSHA256 << "\ngame=" << retained.gameSHA256 << "\nstate=" << retained.stateSHA256 << "\n";
	} else {
		assert(!success);
	}
	duplicatedCompletion(Status::SUCCESS, "duplicate callback");
	assert(callbacks == 1);  // Evidence delivery is once only.
}
