// Actual PPSSPP collector body, explicit display-service fixtures.
#include <cassert>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <mutex>
#include <vector>

/*@@COLLECTED_STATS@@*/

static int count = 4;
static std::vector<float> frames(600), sleeps(600);
void __DisplayGetFPS(float *vps, float *fps, float *actual) {
    *vps = 59.94f; *fps = 30.f; *actual = 29.f;
}
void __DisplayGetDebugStats(char *out, size_t size) { snprintf(out, size, "fixture"); }
float *__DisplayGetFrameTimes(int *valid, int *pos, float **sleep) {
    *valid = count; *pos = count % 600; *sleep = sleeps.data(); return frames.data();
}
struct WebSocketGPUStatsState {
    bool sendNext_ = true, sendFeed_ = false;
    std::mutex pendingLock_;
    std::vector<CollectedStats> pendingStats_;
    void FlipListener();
};

/*@@FLIP_LISTENER@@*/

int main(int argc, char **argv) {
    count = argc > 1 ? atoi(argv[1]) : 4;
    assert(count >= 0 && count <= 600);
    for (int i = 0; i < 600; ++i) { frames[i] = i / 1000.f; sleeps[i] = i / 2000.f; }
    WebSocketGPUStatsState collector;
    collector.FlipListener();
    assert(collector.pendingStats_.size() == 1);
    const auto &stats = collector.pendingStats_[0];
    assert(stats.frameTimes.size() == (size_t)count);
    assert(stats.sleepTimes.size() == (size_t)count);
    assert(stats.frameTimePos == count % 600);
    assert(stats.fps == 30.f && stats.actual_fps == 29.f);
    for (int i = 0; i < count; ++i) {
        assert(stats.frameTimes[i] == frames[i]);
        assert(stats.sleepTimes[i] == sleeps[i]);
    }
    collector.FlipListener();
    assert(collector.pendingStats_.size() == 1);  // One-shot request was consumed.
    collector.sendFeed_ = true;
    collector.FlipListener();
    assert(collector.pendingStats_.size() == 2);
    printf("PASS count=%d\n", count);
}
